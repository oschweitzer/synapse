# Projet Supabase PARTAGÉ avec Cairn (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# URL publique de Synapse (redirections OAuth), ex. https://synapse.vercel.app
# En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL web de Cairn, pour les liens « Ouvrir dans Cairn »
NEXT_PUBLIC_CAIRN_URL=https://<cairn>.netlify.app
