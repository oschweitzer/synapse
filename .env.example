# Projet Supabase PARTAGÉ avec Cairn (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Liste blanche des comptes Google autorisés (emails séparés par des virgules). Vide : accès refusé à tous.
ALLOWED_EMAILS=moi@example.com
# Optionnel : administrateurs (zone dashboards des réglages), sous-ensemble de ALLOWED_EMAILS. Vide : tout compte autorisé.
# ADMIN_EMAILS=moi@example.com

# URL publique de Synapse, ex. https://synapse.vercel.app (utilisée à partir de la phase 3, OAuth Google)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL web de Cairn, pour les liens « Ouvrir dans Cairn » (utilisée à partir de la phase 2)
NEXT_PUBLIC_CAIRN_URL=https://<cairn>.netlify.app

# OAuth Google de Synapse (phase 3), client « Web » dans le projet Google Cloud de Cairn.
# Les mêmes valeurs vont dans les secrets des Edge Functions (voir README).
SYNAPSE_GOOGLE_CLIENT_ID=<client id>.apps.googleusercontent.com
SYNAPSE_GOOGLE_CLIENT_SECRET=<client secret>
# Chiffrement du refresh token : 64 caractères hexadécimaux (`openssl rand -hex 32`),
# identique sur Vercel et dans les secrets des Edge Functions.
SYNAPSE_GOOGLE_TOKEN_KEY=<64 hex>
# Dépenses cash : clé d'API « navigateur » du Google Picker (restreinte au référent
# <NEXT_PUBLIC_SITE_URL>/* et à la Google Picker API). Elle est publique par nature.
SYNAPSE_GOOGLE_PICKER_API_KEY=<api key>

# Verrouillage du dashboard (code + empreinte) : secret de signature des cookies et de hachage
# du code, 32 caractères au moins (`openssl rand -hex 32`). Sans lui, le verrouillage échoue
# fermé : une fois activé, plus personne ne peut déverrouiller.
SYNAPSE_LOCK_SECRET=<64 hex>

# --- Scripts locaux uniquement (pas sur Vercel) ---

# Connexion Postgres pour `npm run db:migrate` (Supabase > Connect > Session pooler)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Id du projet pour `npm run db:types` (après `supabase login`)
SUPABASE_PROJECT_REF=<project-ref>

# --- Tests end-to-end uniquement (vide : les vraies API) ---
# URLs de remplacement des API externes, pointées vers le serveur factice de e2e/mock-server.ts.
# Laisser vide en production et sur Vercel. Environnement complet : e2e/.env.test.example.
# GOOGLE_OAUTH_TOKEN_URL=
# GOOGLE_SHEETS_API_URL=
# OPEN_METEO_FORECAST_URL=
# OPEN_METEO_GEOCODING_URL=
# MEALDB_API_URL=
