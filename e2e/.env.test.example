# Environnement des tests e2e (`npm run test:e2e`) : copier vers e2e/.env.test (ignoré par git).
# Tout doit viser la Supabase LOCALE : le garde-fou refuse tout hôte autre que localhost / 127.0.0.1.
# Les variables déjà définies dans le shell l'emportent sur ce fichier.

# Clés de `npx supabase status -o env` (ANON_KEY et SERVICE_ROLE_KEY)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY de npx supabase status -o env>
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY de npx supabase status -o env>
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Application et comptes de test
E2E_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
E2E_ALLOWED_EMAIL=e2e-allowed@example.test
E2E_MEMBER_EMAIL=e2e-member@example.test
E2E_DENIED_EMAIL=e2e-denied@example.test
E2E_PASSWORD=e2e-password-123
# Le compte autorisé est administrateur ; le compte membre est autorisé mais pas administrateur ;
# le compte refusé ne figure pas dans la liste blanche et doit rester dehors.
ALLOWED_EMAILS=e2e-allowed@example.test,e2e-member@example.test
ADMIN_EMAILS=e2e-allowed@example.test

# Variables de .env.example, avec des valeurs factices : rien ne doit retomber sur le .env.local d'un développeur.
NEXT_PUBLIC_CAIRN_URL=http://localhost:3999
SYNAPSE_GOOGLE_CLIENT_ID=123-e2e.apps.googleusercontent.com
SYNAPSE_GOOGLE_CLIENT_SECRET=e2e-secret
SYNAPSE_GOOGLE_TOKEN_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SYNAPSE_GOOGLE_PICKER_API_KEY=e2e-picker
SYNAPSE_LOCK_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Serveur factice des API externes (e2e/mock-server.ts)
MOCK_PORT=4010
GOOGLE_OAUTH_TOKEN_URL=http://127.0.0.1:4010/google/token
GOOGLE_SHEETS_API_URL=http://127.0.0.1:4010/sheets/v4/spreadsheets
GOOGLE_GMAIL_API_URL=http://127.0.0.1:4010/gmail/v1/users/me
OPEN_METEO_FORECAST_URL=http://127.0.0.1:4010/open-meteo/v1/forecast
OPEN_METEO_GEOCODING_URL=http://127.0.0.1:4010/geocoding/v1/search
MEALDB_API_URL=http://127.0.0.1:4010/mealdb/api/json/v1/1
